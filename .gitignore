# Run artifacts -- regenerated by run.py every run, not source.
# (generated code, generated tests, transaction logs, patches, reports)
outputs/

# Everything belonging to a *project* rather than to the package: your own
# task specs, prompt overrides, settings, and the fixture data copied out of
# the package on first run (src/qikly/paths.py, ensure_task_data).
#
# Ignored in this repo specifically because inputs_private/ is where a real
# user's specs go, and those are exactly what shouldn't reach a public repo
# by accident. The defaults that ship to users live in
# src/qikly/inputs_public/ and are tracked normally.
inputs_private/

# Build artifacts
dist/
build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
.env.*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Throwaway output from `qikly --demo`. Each run gets its own
# demo/<timestamp>/ project root; none of it is repo content.
demo/

# Throwaway task configs written by the research scripts into the bundled
# tasks directory and normally deleted when the run ends. A killed run leaves
# them behind, and `inputs_public/config/tasks/*.yaml` is a glob in
# pyproject.toml, so a committed one would ship in the wheel as though it were
# a real bundled task.
src/qikly/inputs_public/config/tasks/*_EFI.yaml
src/qikly/inputs_public/config/tasks/*_EFR.yaml
src/qikly/inputs_public/config/tasks/*_CONV.yaml
src/qikly/inputs_public/config/tasks/*_ARMI.yaml
src/qikly/inputs_public/config/tasks/*_ARMR.yaml
src/qikly/inputs_public/config/tasks/*_BASE.yaml

outputs/reports/escaped_faults/artifacts/
